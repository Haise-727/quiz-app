# Used by `npm run dev:emulated`. Every value is fake on purpose: this mode talks only to the
# Firebase emulators on your own computer (see docs/technical.md), never to the real project.
# The ImageKit values are still read from .env.local, because media uploads go to the real service.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-quizlike
VITE_FIREBASE_API_KEY=fake-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-quizlike.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-quizlike.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1
VITE_FIREBASE_APP_ID=1:1:web:1
VITE_FIREBASE_DATABASE_URL=https://demo-quizlike-default-rtdb.firebaseio.com

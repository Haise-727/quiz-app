# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Every variable here is required for `npm run dev`
# to start; a missing one usually shows up as a blank white page rather than a
# clear error, because some SDKs are constructed at module scope.

# --- Firebase (project settings > your apps > web app config) -----------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Realtime Database URL, needed for live game sessions.
# Firebase console > Realtime Database. Note the region in the hostname.
VITE_FIREBASE_DATABASE_URL=

# --- ImageKit client SDK (ImageKit dashboard > developer options) -------------
# Public credentials only. The private key belongs in Vercel, never here.
# src/utils/mediaUpload.js (and MediaUploader.jsx) build an ImageKit client at
# module scope, so if these two are blank the SDK throws "Missing urlEndpoint
# during SDK initialization" on import and React never mounts.
VITE_PUBLIC_KEY=
VITE_URL_ENDPOINT=

# --- Media upload signing (development only) --------------------------------
# The editor asks /api/auth for a signed upload token. That function runs on
# Vercel, and `npm run dev` does not serve the api folder, so vite.config.js
# forwards /api to the deployed app. There is nothing to set. Only point it
# somewhere else if you want to test a preview deployment:
# VITE_API_PROXY=https://your-preview-url.vercel.app

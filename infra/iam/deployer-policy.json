{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseTheCdkRolesOnly",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::*:role/cdk-*"
    },
    {
      "Sid": "StartAndLookAtStacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:Describe*",
        "cloudformation:List*",
        "cloudformation:GetTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ValidateTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadTheBillSoClaudeCanWarnYou",
      "Effect": "Allow",
      "Action": [
        "ce:GetCostAndUsage",
        "ce:GetCostForecast",
        "ce:GetAnomalies",
        "budgets:ViewBudget",
        "freetier:GetFreeTierUsage",
        "freetier:GetAccountPlanState",
        "billing:GetBillingData",
        "account:GetAccountInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LookAtWhatIsRunning",
      "Effect": "Allow",
      "Action": [
        "logs:Describe*",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:StartQuery",
        "logs:GetQueryResults",
        "logs:StopQuery",
        "lambda:GetAccountSettings",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:ListFunctions",
        "lambda:ListEventSourceMappings",
        "dynamodb:DescribeTable",
        "dynamodb:DescribeTimeToLive",
        "dynamodb:ListTables",
        "dynamodb:DescribeLimits",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudwatch:GetDashboard",
        "cloudwatch:ListDashboards",
        "cloudtrail:LookupEvents",
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrailStatus",
        "xray:GetServiceGraph",
        "xray:GetTraceSummaries",
        "xray:BatchGetTraces",
        "states:ListStateMachines",
        "states:DescribeStateMachine",
        "states:ListExecutions",
        "states:DescribeExecution",
        "sns:ListTopics",
        "sns:ListSubscriptionsByTopic",
        "sqs:ListQueues",
        "sqs:GetQueueAttributes",
        "events:ListRules",
        "events:DescribeRule",
        "scheduler:ListSchedules",
        "scheduler:GetSchedule",
        "apigateway:GET",
        "ses:GetEmailIdentity",
        "ses:ListEmailIdentities",
        "ses:GetAccount",
        "codepipeline:GetPipelineState",
        "codepipeline:ListPipelines",
        "codebuild:BatchGetBuilds",
        "codebuild:ListBuildsForProject",
        "access-analyzer:ListAnalyzers",
        "access-analyzer:ListFindings",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:ListNamedQueries",
        "athena:GetNamedQuery",
        "athena:GetWorkGroup",
        "glue:GetDatabase",
        "glue:GetTable",
        "glue:GetPartitions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ReadOurOwnTablesToCheckTheData",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/quizlike-*",
        "arn:aws:dynamodb:*:*:table/quizlike-*/index/*"
      ]
    },
    {
      "Sid": "CopyIntoTheNewTableOnly",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/quizlike-main"
    },
    {
      "Sid": "TestOurOwnPiecesOnly",
      "Effect": "Allow",
      "Action": [
        "lambda:InvokeFunction",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "states:StartExecution",
        "cloudwatch:SetAlarmState",
        "athena:StartQueryExecution",
        "athena:StopQueryExecution",
        "codepipeline:StartPipelineExecution",
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:lambda:*:*:function:quizlike-*",
        "arn:aws:states:*:*:stateMachine:quizlike-*",
        "arn:aws:cloudwatch:*:*:alarm:quizlike-*",
        "arn:aws:athena:*:*:workgroup/quizlike*",
        "arn:aws:codepipeline:*:*:quizlike-*",
        "arn:aws:s3:::quizlike-*",
        "arn:aws:s3:::quizlike-*/*"
      ]
    },
    {
      "Sid": "OnlyOurOwnSettings",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:PutParameter",
        "ssm:DescribeParameters"
      ],
      "Resource": "arn:aws:ssm:*:*:parameter/quizlike/*"
    },
    {
      "Sid": "WhoAmI",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "NeverTheseEvenIfSomethingElseAllowsThem",
      "Effect": "Deny",
      "Action": [
        "organizations:*",
        "sso:*",
        "sso-directory:*",
        "controltower:*",
        "ec2:RunInstances",
        "ec2:CreateNatGateway",
        "ec2:AllocateAddress",
        "ec2:CreateVpc",
        "lightsail:*",
        "elasticloadbalancing:*",
        "rds:*",
        "elasticache:*",
        "route53:CreateHostedZone",
        "route53domains:*",
        "secretsmanager:*",
        "kms:CreateKey",
        "wafv2:*",
        "bedrock:*",
        "sagemaker:*",
        "iam:CreateUser",
        "iam:CreateAccessKey",
        "iam:AttachUserPolicy",
        "iam:PutUserPolicy",
        "account:CloseAccount",
        "aws-portal:*"
      ],
      "Resource": "*"
    }
  ]
}
